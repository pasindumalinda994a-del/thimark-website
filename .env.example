# MongoDB connection string (MongoDB Atlas in production)
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/thimark

# Long random string used to sign Payload auth tokens
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site URL, used for admin links in emails and live preview
# Production (Vercel): https://thimark.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Search engine ownership tokens (content value of the verification meta tag). Optional.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Vercel Blob read/write token from a public Blob store. A private store cannot be used.
# When empty, media is stored on local disk in /media
BLOB_READ_WRITE_TOKEN=

# Resend (https://resend.com). When RESEND_API_KEY is empty, emails are logged to the console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@thimark.com
EMAIL_FROM_NAME=Thimark
# Comma-separated list of team inboxes that receive new enquiry notifications
ENQUIRY_NOTIFY_TO=info@thimark.com

# Bearer token Vercel Cron sends to /api/payload-jobs/run (runs scheduled publishing)
CRON_SECRET=

# First admin account, created by `npm run seed`
SEED_ADMIN_EMAIL=admin@thimark.com
SEED_ADMIN_PASSWORD=change-me
